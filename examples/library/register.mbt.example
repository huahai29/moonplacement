// Run as main.mbt in a package that imports "huahai29/moonplacement" @mp.
fn main {
  let source = [@mp.Point::new(0.0, 0.0), @mp.Point::new(2.0, 0.0), @mp.Point::new(0.0, 3.0)]
  let target = [@mp.Point::new(5.0, -3.0), @mp.Point::new(5.0, -1.0), @mp.Point::new(2.0, -3.0)]
  let model : @mp.TransformModel = Rigid
  guard @mp.register(source, target, model, 0.01) is Some(fit) else {
    abort("registration failed")
  }
  let translation = fit.transform.translation()
  let report : Json = {
    "rotation_deg": Json(fit.rotation_deg),
    "translation_mm": Json([translation.x, translation.y]),
    "inliers": Json(fit.inlier_count()),
    "rms_mm": Json(fit.rms_mm),
  }
  println(report.stringify())
}
